<!-- The six flows every Hanzo SDK owes (hanzoai/openapi flows.yaml), compiled
     against the client they demonstrate. Run one: dotnet run, then the flow name. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hanzo.AI.Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Hanzo.AI/Hanzo.AI.csproj" />
  </ItemGroup>

</Project>
