<!--
  The published package: `Hanzo` on nuget.org, namespace Hanzo.AI.

  Api/, Client/ and Model/ are generated from the API document by
  scripts/generate.sh and replaced on every regeneration; never edit them.
  This file and Gateway.cs are the repo's.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the floor: an app on 8, 9 or 10 can take it. hanzoai/openapi
         sdks.yaml's csharp row generates for the same target; keep them equal. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Hanzo.AI</RootNamespace>
    <AssemblyName>Hanzo.AI</AssemblyName>
    <!-- The client's number is cloud's release number: hanzoai/ci's client lane
         rewrites it when a release dispatches here. scripts/version reads it. -->
    <Version>8.5.988</Version>
    <PackageId>Hanzo</PackageId>
    <Authors>Hanzo AI</Authors>
    <Company>Hanzo AI</Company>
    <Description>C# client for the Hanzo Cloud API at api.hanzo.ai — every /v1 operation as a typed method, generated from the API document cloud publishes.</Description>
    <PackageTags>hanzo;ai;llm;api;sdk;openapi</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hanzo-csharp/sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hanzo-csharp/sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- The generator writes nullable annotations without flow analysis. -->
    <Nullable>annotations</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The prose is the document's, transcribed by the generator: a route with
         no description is not a missing doc comment this repo can fix. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- What the generated sources import, nothing more. -->
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
